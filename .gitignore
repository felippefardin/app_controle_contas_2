# --- Dependências do Composer (Nunca versionar) ---
/vendor/

# --- Arquivos de Configuração com Senhas (CRÍTICO) ---
# Você deve criar um config.example.php sem senhas para o repo
includes/config/config.php
includes/config/nfe_config.php

# --- Uploads de Usuários ---
# Ignora arquivos dentro da pasta, mas mantem a pasta
assets/uploads/*
!assets/uploads/.gitkeep
assets/uploads/chat_files/*
!assets/uploads/chat_files/.gitkeep
comprovantes/*
!comprovantes/.gitkeep
banco-dados/*

# --- Arquivos de Sistema e IDEs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.env
.env.*
!.env.example

# Cópias locais de segurança não pertencem ao repositório nem à pasta pública
/backup-codex-*/

# Documentos privados e artefatos gerados em execução
/notas_fiscais/*
!/notas_fiscais/.gitkeep
/storage/notas_fiscais/*
!/storage/notas_fiscais/.gitkeep
/tmp/*
!/tmp/.gitkeep

# --- Logs e Arquivos Temporários ---
*.log
logs/*.log
error_log
pages/webhook_log.txt

# --- Arquivos de Teste e Debug que não devem ir para produção ---
debug_*.php
test_*.php
teste_*.php
ver_log.php
info.php
